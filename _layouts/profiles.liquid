---
layout: default
---
<div class="post">
  <article>
    <h1>{{ page.title }}</h1>
    <div class="clearfix">
      {{ content }}
    </div>
    <p>{{ page.description }}</p>
    {% if page.profiles %}
      <div class="container">
        <div class="row justify-content-center" data-team-shuffle="current">
          {% for profile in page.profiles %}
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 d-flex align-items-stretch">
              <div class="profile text-center">
                {% if profile.image %}
                  {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
                  {% if profile.image_circular %}
                    {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
                  {% else %}
                    {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
                  {% endif %}
                  <img src="{{ profile_image_path | relative_url }}" class="{{ profile_image_class }}" width="200" height="200" alt="{{ profile.name | escape }}">
                {% endif %}
                {% if profile.name %}
                  {% if profile.link %}
                    <p class="profile-name"><a href="{{ profile.link }}" target="_blank" rel="noopener noreferrer">{{ profile.name }}</a></p>
                  {% else %}
                    <p class="profile-name">{{ profile.name }}</p>
                  {% endif %}
                {% endif %}
                {% if profile.department %}
                  <p class="profile-department">{{ profile.department }}</p>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <section class="team-alumni" aria-labelledby="alumni-heading">
      <h2 id="alumni-heading">Alumni</h2>
      {% if page.alumni_profiles.size > 0 %}
        <h3>Ph.D. Students and Postdocs</h3>
        <ul class="team-alumni-list">
          {% assign sorted_alumni = page.alumni_profiles | sort: "sort_name" %}
          {% for profile in sorted_alumni %}
            <li>
              {% if profile.link %}
                <a href="{{ profile.link }}" target="_blank" rel="noopener noreferrer">{{ profile.name }}</a>
              {% else %}
                {{ profile.name }}
              {% endif %}
              {% if profile.department %}<span> — {{ profile.department }}</span>{% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
      {% if page.ug_alumni_profiles.size > 0 %}
        <h3>Undergraduate and Master's Students</h3>
        <ul class="team-alumni-list">
          {% assign sorted_ug_alumni = page.ug_alumni_profiles | sort: "sort_name" %}
          {% for profile in sorted_ug_alumni %}
            <li>
              {% if profile.link %}
                <a href="{{ profile.link }}" target="_blank" rel="noopener noreferrer">{{ profile.name }}</a>
              {% else %}
                {{ profile.name }}
              {% endif %}
              {% if profile.department %}<span> — {{ profile.department }}</span>{% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </section>
  </article>
</div>
<script defer src="{{ '/assets/js/team.js' | relative_url | bust_file_cache }}"></script>
